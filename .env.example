# Kopiér til .env og udfyld POSTGRES_PASSWORD. Se DEPLOYMENT.md.

# Auth: local bruger konti i denne installation, central bruger Mercantec Auth.
Auth__Mode=local
MercantecAuth__ClientId=gf2-learn
MercantecAuth__ClientSecret=

# PostgreSQL. Vælg en lang, unik adgangskode (fx 32 tilfældige hextegn).
POSTGRES_DB=gf2learn
POSTGRES_USER=gf2
POSTGRES_PASSWORD=

# Lokal Docker på http://localhost:8031
WEB_HOST_PORT=8031

# Dokploy. Sæt domæne og et unikt præfiks pr. app.
APP_DOMAIN=learn.gf2.dk
TRAEFIK_PREFIX=gf2learn-prod

# Officiel VAT-branding i afleveringsversionen.
VidenscenterBranding__Enabled=true

# Valgfri AI-hjælp til opgaver. Nøglen bliver på webserveren.
OpenAi__ApiKey=
OpenAi__Model=gpt-4o-mini

# Ekstra adminadgang via bruger-ID fra /profile. Adskil flere ID'er med komma.
AdminAccess__EducatorSubjects=
AdminAccess__SuperAdminSubjects=
