@inject IConfiguration Configuration
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@using GF2Learn.Web.Auth
@{
    var rootHttpContext = HttpContextAccessor.HttpContext;
    var isAuthenticated = rootHttpContext?.User.Identity?.IsAuthenticated == true;
    var authUser = rootHttpContext?.User;
    var activityTrackingEnabled = isAuthenticated
        && !string.IsNullOrWhiteSpace(Configuration.GetConnectionString("DefaultConnection"));
    var requestVerificationToken = rootHttpContext is null || !activityTrackingEnabled
        ? null
        : Antiforgery.GetAndStoreTokens(rootHttpContext).RequestToken;
}
<!DOCTYPE html>
<html lang="da">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="gf2-path-base" content="@(Configuration["PathBase"] ?? "")" />
    <meta name="gf2-authenticated" content="@(isAuthenticated ? "true" : "false")" />
    <meta name="gf2-auth-access-issued-at" content="@authUser?.FindFirst(AuthSessionMetadataClaims.AccessTokenIssuedAt)?.Value" />
    <meta name="gf2-auth-access-expires-at" content="@authUser?.FindFirst(AuthSessionMetadataClaims.AccessTokenExpiresAt)?.Value" />
    <meta name="gf2-auth-cookie-issued-at" content="@authUser?.FindFirst(AuthSessionMetadataClaims.CookieIssuedAt)?.Value" />
    <meta name="gf2-auth-cookie-expires-at" content="@authUser?.FindFirst(AuthSessionMetadataClaims.CookieExpiresAt)?.Value" />
    <meta name="gf2-activity-enabled" content="@(activityTrackingEnabled ? "true" : "false")" />
    <meta name="request-verification-token" content="@requestVerificationToken" />
    <script src="@Assets["js/theme-head.js"]"></script>
    <base href="/" />
    <title>GF2 Learn</title>
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/dev-theme.css"]" />
    <link rel="stylesheet" href="@Assets["css/admin.css"]" />
    <link rel="stylesheet" href="@Assets["GF2Learn.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <IssueReportLink />
    <ReconnectModal />
    <script src="@Assets["js/theme.js"]"></script>
    <script src="@Assets["js/site.js"]"></script>
    <script src="@Assets["vendor/highlightjs/highlight.min.js"]"></script>
    <script src="@Assets["vendor/highlightjs/languages/csharp.min.js"]"></script>
    <script src="@Assets["vendor/highlightjs/languages/bash.min.js"]"></script>
    <script src="@Assets["js/highlight-code.js"]"></script>
    <script src="@Assets["js/playground-csharp-intellisense.js"]"></script>
    <script src="@Assets["js/playground-editor.js"]"></script>
    <script src="@Assets["js/exercise-page-load.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/highlight-nav.js"]"></script>
    <script src="@Assets["js/knowledge-check.js"]"></script>
    <script src="@Assets["js/slide-deck.js"]"></script>
    <script src="@Assets["js/gf2-api.js"]"></script>
    <script src="@Assets["js/exercise-progress.js"]"></script>
    <script src="@Assets["js/exercise-ai.js"]"></script>
    <script src="@Assets["js/page-activity.js"]"></script>
</body>

</html>
