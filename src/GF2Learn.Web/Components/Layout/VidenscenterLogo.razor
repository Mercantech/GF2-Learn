@inject IConfiguration Configuration

<div class="videnscenter-branding @SizeClass @CssClass" style="--vat-logo-width: @(VatWidth)px">
    @if (Linkable)
    {
        <a href="https://videnscenterportalen.dk/vat/"
           target="_blank"
           rel="noopener"
           class="videnscenter-logo-link"
           title="Videnscenter for Automation og Teknologi">
            <img src="@LogoUrl"
                 alt="Videnscenter for Automation og Teknologi"
                 class="videnscenter-logo videnscenter-logo--vat videnscenter-logo--light"
                 width="@VatWidth"
                 height="@VatHeight" />
            <img src="@DarkLogoUrl"
                 alt="Videnscenter for Automation og Teknologi"
                 class="videnscenter-logo videnscenter-logo--vat videnscenter-logo--dark"
                 width="@VatWidth"
                 height="@VatHeight" />
        </a>
    }
    else
    {
        <span class="videnscenter-logo-mark" title="Videnscenter for Automation og Teknologi">
            <img src="@LogoUrl"
                 alt="Videnscenter for Automation og Teknologi"
                 class="videnscenter-logo videnscenter-logo--vat videnscenter-logo--light"
                 width="@VatWidth"
                 height="@VatHeight" />
            <img src="@DarkLogoUrl"
                 alt="Videnscenter for Automation og Teknologi"
                 class="videnscenter-logo videnscenter-logo--vat videnscenter-logo--dark"
                 width="@VatWidth"
                 height="@VatHeight" />
        </span>
    }
</div>

@code {
    private string LogoUrl => $"/{(Configuration["PathBase"] ?? "").Trim('/')}/images/partners/Logo_VAT_farver.svg".Replace("//", "/");

    private string DarkLogoUrl => LogoUrl.Replace("Logo_VAT_farver.svg", "Logo_VAT_hvid-1.svg");

    [Parameter] public string Size { get; set; } = "footer";

    [Parameter] public bool Linkable { get; set; } = true;

    [Parameter] public string? CssClass { get; set; }

    private string SizeClass => Size switch
    {
        "header" => "videnscenter-branding--header",
        "hero" => "videnscenter-branding--hero",
        "deck" => "videnscenter-branding--deck",
        _ => "videnscenter-branding--footer"
    };

    private int VatWidth => Size switch
    {
        "header" => 220,
        "hero" => 320,
        "deck" => 240,
        _ => 280
    };

    private int VatHeight => Size switch
    {
        "header" => 44,
        "hero" => 64,
        "deck" => 48,
        _ => 56
    };

}
