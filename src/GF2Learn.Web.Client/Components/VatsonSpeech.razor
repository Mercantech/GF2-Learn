<div class="vatson-speech @VariantClass" role="status">
    <img class="vatson-speech-avatar"
         src="@AvatarUrl"
         width="@AvatarSize"
         height="@AvatarSize"
         alt=""
         aria-hidden="true" />
    <div class="vatson-speech-bubble">
        <p class="vatson-speech-name">Vatson</p>
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <p class="vatson-speech-title">@Title</p>
        }
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <p class="vatson-speech-body">@Message</p>
        }
        @if (ChildContent is not null)
        {
            <div class="vatson-speech-body">@ChildContent</div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public string Variant { get; set; } = "hint";
    [Parameter] public int AvatarSize { get; set; } = 80;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string AvatarUrl => VatsonImages.ForVariant(Variant);

    private string VariantClass => Variant switch
    {
        "ok" => "vatson-speech-ok",
        "warn" => "vatson-speech-warn",
        _ => "vatson-speech-hint"
    };
}
